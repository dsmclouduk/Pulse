{
  "name": "pulse",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev/dev.mjs",
    "db:local": "docker compose up -d db",
    "db:local:down": "docker compose down",
    "tunnel": "node scripts/dev/tunnel.mjs",
    "test": "npm test --workspace server",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev:no-db": "node scripts/dev/dev.mjs --no-db"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prisma": "^6.8.2",
    "typescript": "^5.8.0"
  }
}
