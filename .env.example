# Webhook security
WEBHOOK_SECRET=changeme-generate-a-random-string

# Server
PORT=3001

# Azure SQL / Prisma. Leave empty for in-memory mode. For local SQL Server: `npm run db:local` then
# DATABASE_URL="sqlserver://localhost:14330;database=Pulse;user=sa;password=Pulse_Dev_Passw0rd!;encrypt=true;trustServerCertificate=true"
DATABASE_URL=

# Azure platform identity and hosting
# Public base URL Azure can reach: the App Service URL in production, your ngrok static domain locally
# (`npm run tunnel` runs `ngrok http $PORT --url $APP_SERVICE_URL`).
APP_SERVICE_URL=https://pulse-monitor.azurewebsites.net
AZURE_PLATFORM_TENANT_ID=
AZURE_PLATFORM_CLIENT_ID=
AZURE_PLATFORM_APP_OBJECT_ID=
AZURE_KEY_VAULT_URI=

# Azure service principal for READ access (metrics, Log Analytics). Locally: a temporary SP with a client secret
# in the Synextra tenant with Reader + Monitoring Reader + Log Analytics Reader on the test subscription
# (docs/LIVE-TEST-PLAN.md). Production: App Service managed identity or a Key Vault certificate.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_IDS=

# Alert enrichment: metric history + trend analysis + agent diagnosis
# Optional. Guest (VM Insights) history is queried in resource context, which needs only the Azure
# credentials above. This is the fallback workspace for the workspace-context form; note that many
# workspaces are set to "resource permissions only" and refuse workspace-context queries outright.
LOG_ANALYTICS_WORKSPACE_ID=
# Optional. Without it the agent falls back to a rule-based diagnosis (clearly labelled in the UI).
ANTHROPIC_API_KEY=
PULSE_AGENT_PROVIDER=auto
PULSE_AGENT_MODEL=claude-opus-5
PULSE_AGENT_TIMEOUT_MS=30000
PULSE_ENRICHMENT_ENABLED=true
PULSE_ENRICHMENT_TIMEOUT_MS=60000
PULSE_ENRICHMENT_COOLDOWN_MS=900000
PULSE_ENRICHMENT_ON_RESOLVED=note
PULSE_HISTORY_DAYS=90

# Dev tunnel reference only
NGROK_URL=https://xxxx.ngrok-free.app
